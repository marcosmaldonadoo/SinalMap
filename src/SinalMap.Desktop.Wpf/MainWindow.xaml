<Window x:Class="SinalMap.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SinalMap.Desktop.Wpf.Controls"
        Title="SinalMap — coleta Wi-Fi" Width="1280" Height="860" MinWidth="1000" MinHeight="700"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}" FontFamily="{StaticResource InterfaceFont}" FontSize="{StaticResource TextBody}"
        Typography.NumeralAlignment="Tabular"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="InterfaceState" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Text" Value="Estado desconhecido" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Connected"><Setter Property="Text" Value="Conectado" /><Setter Property="Foreground" Value="{StaticResource Accent}" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Disconnected"><Setter Property="Text" Value="Desconectado" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Unavailable"><Setter Property="Text" Value="Indisponível" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResultTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Visibility" Value="{Binding DataContext.HasResult, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" />
        </Style>
        <Style x:Key="Statistic" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceSubtle}" /><Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
            <Setter Property="Padding" Value="16" /><Setter Property="Margin" Value="12,0,0,0" />
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding MonitorCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>
    <Grid Margin="24,20,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Image Source="Assets/sinalmap-logo.png" Width="144" Height="48" Stretch="Uniform" AutomationProperties.Name="SinalMap" />
            <Grid Grid.Column="1" Margin="24,0,16,0" VerticalAlignment="Center">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding ActivityTitle}" FontSize="{StaticResource TextHeading}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource Metadata}" /><Style.Triggers>
                            <DataTrigger Binding="{Binding IsMonitoring}" Value="True"><Setter Property="Fill" Value="{StaticResource Accent}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Fill" Value="{StaticResource WarningInk}" /></DataTrigger>
                            <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Fill" Value="{StaticResource ErrorInk}" /></DataTrigger>
                        </Style.Triggers></Style></Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding OperationLabel}" FontSize="{StaticResource TextMetadata}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="·" Margin="8,0" Style="{StaticResource Caption}" FontSize="{StaticResource TextMetadata}" />
                    <TextBlock Text="{Binding ActivityDescription}" Style="{StaticResource Caption}" FontSize="{StaticResource TextMetadata}" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding MonitorCommand}" Margin="0,0,8,0" Style="{StaticResource QuietButton}"
                        ToolTip="Voltar ao monitoramento sem gravar uma coleta (Ctrl+L)" AutomationProperties.Name="Sinal ao vivo">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M0,8 L3,8 5,2 8,14 11,6 13,8 17,8" Stroke="{StaticResource Accent}" StrokeThickness="1.6" Width="18" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="Ao vivo" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenCommand}" ToolTip="Abrir uma coleta salva (Ctrl+O)" AutomationProperties.Name="Abrir coleta salva">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M1,4 L6,4 8,6 17,6 17,16 1,16 Z M1,8 L17,8" Stroke="{StaticResource Accent}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="Abrir coleta" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}"
                Padding="16,12" Margin="0,0,0,16" Visibility="{Binding ShowOperationNotice, Converter={StaticResource BoolVisibility}}"
                AutomationProperties.Name="Estado da operação">
            <StackPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="{StaticResource TextSmall}" />
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource ErrorInk}" FontWeight="SemiBold" Margin="0,4,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" />
                <ProgressBar IsIndeterminate="True" Height="3" Foreground="{StaticResource Accent}" Margin="0,8,0,0" BorderThickness="0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Background="Transparent" BorderThickness="0,0,1,0" CornerRadius="0" Padding="0,8,24,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <Border Background="{StaticResource WarningSurface}" BorderBrush="{StaticResource WarningBorder}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="12" Margin="0,0,0,12"
                                Visibility="{Binding HasPendingSave, Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Sua coleta ainda não foi salva" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource WarningInk}" />
                                <TextBlock Text="Os dados estão em memória. Escolha outra pasta e tente novamente." Style="{StaticResource Caption}" Margin="0,8,0,12" />
                                <Button Content="Escolher outra pasta…" Command="{Binding ChooseFolderCommand}" Margin="0,0,0,8" />
                                <Button Content="Tentar salvar novamente" Command="{Binding RetrySaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
                                <Button Content="Descartar sessão…" Command="{Binding DiscardCommand}" Style="{StaticResource QuietButton}" />
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding StartCommand}" MinHeight="48" FontSize="{StaticResource TextSmall}" AutomationProperties.Name="Iniciar medição de 60 segundos">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers>
                                <DataTrigger Binding="{Binding HasPendingSave}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers></Style></Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M0,0 L0,12 9,6 Z" Fill="{StaticResource Surface}" Width="9" Height="12" Stretch="Uniform" Margin="2,0,12,0" />
                                <TextBlock Text="Coletar por 60 segundos" />
                            </StackPanel>
                        </Button>
                        <Button Content="Parar e salvar parcial" Command="{Binding CancelCommand}" Margin="0,8,0,0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <TextBlock Text="A coleta será salva em um arquivo JSON." FontSize="{StaticResource TextMetadata}" TextAlignment="Center" Margin="0,12,0,0">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers>
                                <DataTrigger Binding="{Binding HasPendingSave}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Style="{StaticResource IconButton}" ToolTip="Atualizar interfaces (F5)" AutomationProperties.Name="Atualizar interfaces">
                                    <Path Data="M14,5 A6,6 0 1 0 15,10 M10,5 L15,5 15,0" Stroke="{StaticResource Accent}" StrokeThickness="1.6" Width="17" Height="17" Stretch="Uniform" />
                                </Button>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="INTERFACE" Style="{StaticResource Eyebrow}" /><TextBlock Text="Conexão de medição" FontSize="{StaticResource TextSection}" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                            </DockPanel>
                            <Label Content="_Interface Wi-Fi" Target="{Binding ElementName=InterfaceInput}" Style="{StaticResource FormLabel}" />
                            <ComboBox x:Name="InterfaceInput" ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}"
                                      IsEnabled="{Binding CanReplaceSession}" AutomationProperties.Name="Interface Wi-Fi">
                                <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Description}" />
                                </Style></ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate><DataTemplate><StackPanel>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="220" FontSize="{StaticResource TextSmall}" />
                                    <TextBlock Style="{StaticResource InterfaceState}" FontSize="{StaticResource TextMetadata}" Margin="0,4,0,0" />
                                </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel Margin="0,16,0,0">
                                <TextBlock Text="REDE CONECTADA · SSID" Style="{StaticResource Eyebrow}" />
                                <TextBlock Text="{Binding ConnectedNetworkName}" ToolTip="{Binding ConnectedNetworkName}"
                                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"
                                           AutomationProperties.Name="Nome da rede Wi-Fi conectada" />
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource Line}" Margin="0,24" />
                            <TextBlock Text="GRAVAÇÃO" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="Coleta de 60 segundos" FontSize="{StaticResource TextSection}" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock Text="Sinal e latência salvos em JSON." Style="{StaticResource Caption}" Margin="0,8,0,16" />
                            <Label Content="_Destino IPv4" Target="{Binding ElementName=TargetInput}" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="TargetInput" Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanReplaceSession}"
                                     FontFamily="{StaticResource MeasurementFont}" Tag="Ex.: 192.168.1.1" AutomationProperties.Name="Destino IPv4" ToolTip="Gateway ou outro destino autorizado para o teste ICMP">
                                <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers><DataTrigger Binding="{Binding HasTargetError}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource ErrorBorder}" /></DataTrigger></Style.Triggers>
                                </Style></TextBox.Style>
                            </TextBox>
                            <TextBlock Text="{Binding TargetHint}" Style="{StaticResource Caption}" FontSize="{StaticResource TextMetadata}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding TargetError}" TextWrapping="Wrap" Foreground="{StaticResource ErrorInk}" FontSize="{StaticResource TextMetadata}" Margin="0,8,0,0"
                                       Visibility="{Binding HasTargetError, Converter={StaticResource BoolVisibility}}" />
                            <Expander Margin="0,16,0,0" AutomationProperties.Name="Pasta de resultados">
                                <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                                    <Style.Triggers><DataTrigger Binding="{Binding HasPendingSave}" Value="True"><Setter Property="IsExpanded" Value="True" /></DataTrigger></Style.Triggers>
                                </Style></Expander.Style>
                                <Expander.Header><StackPanel><TextBlock Text="Pasta de resultados" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OutputFolder}" ToolTip="{Binding OutputFolder}" FontSize="{StaticResource TextMetadata}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="218" Margin="0,4,0,0" /></StackPanel></Expander.Header>
                                <StackPanel Margin="0,8,0,4">
                                    <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditFolder}"
                                             AutomationProperties.Name="Pasta dos resultados" TextWrapping="Wrap" MinHeight="58" />
                                    <Button Content="Escolher pasta…" Command="{Binding ChooseFolderCommand}" Style="{StaticResource QuietButton}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Expander>
                            <Border Background="{StaticResource WarningSurface}" CornerRadius="{StaticResource ControlRadius}" Padding="12" Margin="0,16,0,8">
                                <StackPanel>
                                    <TextBlock Text="Varredura Wi-Fi a cada 5 s" FontSize="{StaticResource TextSmall}" FontWeight="SemiBold" Foreground="{StaticResource WarningInk}" />
                                    <TextBlock Text="A cada 5 s no monitor e na coleta. Pode influenciar a latência do teste." Style="{StaticResource Caption}" FontSize="{StaticResource TextMetadata}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Expander Header="Privacidade dos registros">
                                <TextBlock Text="O JSON contém identificadores da rede. Revise o arquivo antes de compartilhar. O teste ICMP usa somente o destino informado." Style="{StaticResource Caption}" FontSize="{StaticResource TextMetadata}" Margin="0,8,0,0" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24,16">
                <TabControl DataContext="{Binding Result}"
                            SelectedIndex="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
                    <TabItem Header="Visão geral" DataContext="{Binding DataContext.Signal, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ScrollViewer x:Name="SignalScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Tag="{Binding HistoryRevision, Mode=OneWay, NotifyOnTargetUpdated=True}" TargetUpdated="OnSignalHistoryChanged">
                            <Grid Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                <Grid.Style><Style TargetType="Grid"><Setter Property="MinHeight" Value="480" /><Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded, ElementName=SignalDetails}" Value="True"><Setter Property="MinHeight" Value="660" /></DataTrigger>
                                </Style.Triggers></Style></Grid.Style>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="220" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Margin="0,4,0,24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="256" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Potência do sinal" FontSize="{StaticResource TextSmall}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="88" Margin="0,4,0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding NumericValue}" Style="{StaticResource Measurement}" FontSize="{StaticResource TextReadout}" FontWeight="SemiBold"
                                                           AutomationProperties.Name="{Binding Value, StringFormat=Sinal Wi-Fi: {0}}" />
                                                <TextBlock Text="dBm" FontSize="{StaticResource TextHeading}" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="8,0,0,12" />
                                            </StackPanel>
                                        </Viewbox>
                                        <TextBlock Text="{Binding Position}" Style="{StaticResource Caption}" FontSize="{StaticResource TextMetadata}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel ToolTip="Menor RSSI registrado nesta janela."><TextBlock Text="Mínimo observado" Style="{StaticResource Caption}" FontSize="{StaticResource TextMetadata}" />
                                                <TextBlock Text="{Binding Minimum}" Style="{StaticResource Measurement}" FontSize="{StaticResource TextHeading}" Margin="0,4,0,0" /></StackPanel>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" ToolTip="Maior RSSI registrado nesta janela."><TextBlock Text="Máximo observado" Style="{StaticResource Caption}" FontSize="{StaticResource TextMetadata}" />
                                                <TextBlock Text="{Binding Maximum}" Style="{StaticResource Measurement}" FontSize="{StaticResource TextHeading}" Margin="0,4,0,0" /></StackPanel>
                                        </Grid>
                                        <TextBlock Text="Escala de RSSI · dBm" Style="{StaticResource Caption}" FontSize="{StaticResource TextMetadata}" Margin="0,12,0,0" />
                                        <controls:RssiRuler Value="{Binding CurrentRssiDbm, Mode=OneWay}" Height="44" ToolTip="O marcador acompanha a leitura exibida. A escala se amplia para acomodar valores fora dos limites usuais." />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="{StaticResource AccentTint}" CornerRadius="{StaticResource ControlRadius}" Padding="12,9" Margin="0,0,0,16"
                                        Visibility="{Binding IsCollecting, Converter={StaticResource BoolVisibility}}">
                                    <StackPanel><TextBlock Text="{Binding ProgressLabel}" FontSize="{StaticResource TextMetadata}" FontWeight="SemiBold" />
                                        <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Height="4" Foreground="{StaticResource Accent}" BorderThickness="0" Background="{StaticResource ControlSelection}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding HistoryTitle}" FontSize="{StaticResource TextSection}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding HistoryHint}" Style="{StaticResource Caption}" FontSize="{StaticResource TextMetadata}" Margin="0,4,0,0" /></StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource AccentTint}" CornerRadius="5" Padding="8,5" VerticalAlignment="Top" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding StateLabel}" FontSize="{StaticResource TextMetadata}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                                        </Border>
                                    </Grid>
                                    <controls:SignalChart Grid.Row="1" Points="{Binding Points}" TimeAxisLabel="{Binding TimeAxisLabel}" ClipToBounds="True"
                                                          AutomationProperties.Name="Histórico de RSSI em dBm" AutomationProperties.HelpText="Use o mouse ou as setas esquerda e direita para inspecionar as leituras. Home e End vão para a primeira e a última posição." />
                                </Grid>
                                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ReadingsLabel}" FontSize="{StaticResource TextMetadata}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding RefreshSummary}" ToolTip="{Binding RefreshNotice}" Foreground="{StaticResource Muted}" FontSize="{StaticResource TextMetadata}" />
                                    </Grid>
                                    <Expander x:Name="SignalDetails" Header="Detalhes e diagnóstico" Margin="0,8,0,0">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="{Binding ReadingStatus}" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding RefreshNotice}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding LatestIssues}" TextWrapping="Wrap" Foreground="{StaticResource ErrorInk}" Margin="0,4,0,0" Visibility="{Binding HasIssues, Converter={StaticResource BoolVisibility}}" />
                                            <TextBlock Text="Use o mouse ou ← → para explorar o gráfico. Ausências e mudanças de contexto interrompem a linha. O RSSI depende do driver." Style="{StaticResource Caption}" FontSize="{StaticResource TextMetadata}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Resumo" Style="{StaticResource ResultTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                            <TextBlock Text="Resumo da coleta" FontSize="{StaticResource TextHeading}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" Margin="0,4,0,16" />
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource Statistic}" Margin="0,0,8,8"><StackPanel><TextBlock Text="POSIÇÕES DESPACHADAS" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding Positions}" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel></Border>
                                <Border Style="{StaticResource Statistic}" Margin="8,0,0,8"><StackPanel><TextBlock Text="RESPOSTAS ICMP" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding Icmp}" FontSize="{StaticResource TextHeading}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></Border>
                                <Border Style="{StaticResource Statistic}" Margin="0,8,8,0"><StackPanel><TextBlock Text="LATÊNCIA · RTT EM SUCESSO" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding Rtt}" FontSize="{StaticResource TextSection}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></Border>
                                <Border Style="{StaticResource Statistic}" Margin="8,8,0,0"><StackPanel><TextBlock Text="SINAL REGISTRADO" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding Rssi}" FontSize="{StaticResource TextSection}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></Border>
                            </UniformGrid>
                            <TextBlock Text="{Binding ScanNotice}" TextWrapping="Wrap" Foreground="{StaticResource WarningInk}" Margin="0,20,0,12" />
                            <Border Background="{StaticResource SurfaceSubtle}" CornerRadius="{StaticResource ControlRadius}" Padding="12"><TextBlock Text="{Binding ContextNotice}" TextWrapping="Wrap" FontSize="{StaticResource TextSmall}" /></Border>
                            <Expander Header="Disponibilidade e agenda" Margin="0,14,0,0"><StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding Availability}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <TextBlock Text="{Binding Schedule}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <TextBlock Text="{Binding Sources}" TextWrapping="Wrap" />
                            </StackPanel></Expander>
                            <TextBlock Text="Estatísticas descritivas. Não representam um diagnóstico automático de cobertura, interferência ou saúde da rede." Style="{StaticResource Caption}" FontSize="{StaticResource TextMetadata}" Margin="0,12,0,0" />
                        </StackPanel></ScrollViewer>
                    </TabItem>
                    <TabItem Header="Amostras" Style="{StaticResource ResultTab}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,14"><TextBlock Text="Selecione e copie com Ctrl+C" DockPanel.Dock="Right" Style="{StaticResource Caption}" FontSize="{StaticResource TextMetadata}" />
                                <TextBlock Text="{Binding Summary.Positions, StringFormat={}{0} posições registradas}" FontSize="14" FontWeight="SemiBold" /></DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Samples}" FrozenColumnCount="3" ClipboardCopyMode="IncludeHeader" AutomationProperties.Name="Amostras da sessão">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Posição" Binding="{Binding Position}" Width="75" ElementStyle="{StaticResource MetricCellText}" HeaderStyle="{StaticResource MetricColumnHeader}" />
                                    <DataGridTextColumn Header="RSSI" Binding="{Binding Rssi}" Width="112" ElementStyle="{StaticResource MetricCellText}" HeaderStyle="{StaticResource MetricColumnHeader}" />
                                    <DataGridTextColumn Header="RTT" Binding="{Binding Rtt}" Width="136" ElementStyle="{StaticResource MetricCellText}" HeaderStyle="{StaticResource MetricColumnHeader}" />
                                    <DataGridTextColumn Header="Wi-Fi" Binding="{Binding Wifi}" Width="120" />
                                    <DataGridTextColumn Header="ICMP" Binding="{Binding Icmp}" Width="120" />
                                    <DataGridTextColumn Header="Agenda" Binding="{Binding Disposition}" Width="175" />
                                    <DataGridTextColumn Header="Canal" Binding="{Binding Channel}" Width="85" ElementStyle="{StaticResource MetricCellText}" HeaderStyle="{StaticResource MetricColumnHeader}" />
                                    <DataGridTextColumn Header="Frequência / fonte" Binding="{Binding CachedFrequency}" Width="250" />
                                    <DataGridTextColumn Header="Fonte RSSI" Binding="{Binding RssiSource}" Width="155" />
                                    <DataGridTextColumn Header="Ocorrências (código)" Binding="{Binding Occurrences}" Width="310" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Contexto" Style="{StaticResource ResultTab}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="{Binding ContextNotice}" TextWrapping="Wrap" Margin="0,0,0,16" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Context}" ClipboardCopyMode="IncludeHeader"><DataGrid.Columns>
                                <DataGridTextColumn Header="Campo" Binding="{Binding Field}" Width="200" />
                                <DataGridTextColumn Header="Contexto registrado" Binding="{Binding State}" Width="*" />
                            </DataGrid.Columns></DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Ocorrências" Style="{StaticResource ResultTab}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="{Binding OccurrenceNotice}" TextWrapping="Wrap" Margin="0,0,0,16" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Occurrences}" ClipboardCopyMode="IncludeHeader"><DataGrid.Columns>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="*" />
                                <DataGridTextColumn Header="Código nativo" Binding="{Binding Code}" Width="135" />
                                <DataGridTextColumn Header="Posições" Binding="{Binding Positions}" Width="95" />
                            </DataGrid.Columns></DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="Windows · dados locais · sem telemetria" Style="{StaticResource Caption}" FontSize="{StaticResource TextMetadata}" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding SavedFileName, StringFormat=Arquivo: {0}}" ToolTip="{Binding SavedPath}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Metadata}" FontSize="{StaticResource TextMetadata}" Margin="0,0,280,0"
                       Visibility="{Binding HasSavedPath, Converter={StaticResource BoolVisibility}}" />
        </Grid>
    </Grid>
</Window>
