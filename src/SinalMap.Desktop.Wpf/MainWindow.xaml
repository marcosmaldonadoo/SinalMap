<Window x:Class="SinalMap.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SinalMap.Desktop.Wpf.Controls"
        Title="SinalMap — coleta Wi-Fi" Width="1240" Height="850" MinWidth="1000" MinHeight="700"
        Background="#F3F6FA" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="InterfaceState" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Text" Value="Indeterminado" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Connected"><Setter Property="Text" Value="Conectado" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Disconnected"><Setter Property="Text" Value="Desconectado" /></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Unavailable"><Setter Property="Text" Value="Indisponível" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResultTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="IsEnabled" Value="{Binding DataContext.HasResult, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>
    <Grid Margin="24,18,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Image Source="Assets/sinalmap-logo.png" Width="148" Height="50" Stretch="Uniform" AutomationProperties.Name="SinalMap" />
            <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Monitor de sinal" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Wi-Fi · coleta e análise local" Style="{StaticResource Caption}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Sinal ao vivo" Command="{Binding MonitorCommand}" Margin="0,0,8,0" ToolTip="Acompanhar o sinal sem ICMP e sem gravar uma sessão" />
            <Button Command="{Binding OpenCommand}" ToolTip="Abrir coleta salva (Ctrl+O)" AutomationProperties.Name="Abrir coleta salva">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M1,4 L6,4 8,6 17,6 17,16 1,16 Z M1,8 L17,8" Stroke="{StaticResource Accent}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock Text="Abrir coleta" />
                </StackPanel>
            </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,18" AutomationProperties.Name="Estado da operação">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border CornerRadius="5" Padding="9,5" VerticalAlignment="Top" Margin="0,0,14,0">
                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource AccentTint}" /><Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Background" Value="#FCECED" /></DataTrigger>
                        <DataTrigger Binding="{Binding HasPendingSave}" Value="True"><Setter Property="Background" Value="#FFF1D5" /></DataTrigger>
                    </Style.Triggers></Style></Border.Style>
                    <TextBlock Text="{Binding OperationLabel}" FontSize="10" FontWeight="Bold">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Accent}" /><Style.Triggers>
                            <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="#9F2D37" /></DataTrigger>
                            <DataTrigger Binding="{Binding HasPendingSave}" Value="True"><Setter Property="Foreground" Value="#805A16" /></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#B23C42" Margin="0,5,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" />
                    <ProgressBar IsIndeterminate="True" Height="3" Foreground="{StaticResource Accent}" Margin="0,8,0,0" BorderThickness="0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="278" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="18">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <Border Background="#FFF6E5" BorderBrush="#EAD5A6" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,12"
                                Visibility="{Binding HasPendingSave, Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Sessão não salva" FontWeight="SemiBold" Foreground="#805A16" />
                                <TextBlock Text="Os dados estão em memória. Confira a pasta e tente novamente." Style="{StaticResource Caption}" Margin="0,5,0,10" />
                                <Button Content="Tentar salvar novamente" Command="{Binding RetrySaveCommand}" Margin="0,0,0,6" />
                                <Button Content="Descartar sessão…" Command="{Binding DiscardCommand}" Style="{StaticResource QuietButton}" />
                            </StackPanel>
                        </Border>
                        <Button Content="Iniciar medição · 60 s" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Iniciar medição de 60 segundos" />
                        <Button Content="Cancelar e salvar parcial" Command="{Binding CancelCommand}" Margin="0,8,0,0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <TextBlock Text="Resultados salvos em JSON no seu computador." Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Configurar medição" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Escolha a conexão e o destino do teste." Style="{StaticResource Caption}" Margin="0,5,0,16" />
                            <TextBlock Text="Interface Wi-Fi" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}"
                                      IsEnabled="{Binding CanReplaceSession}" AutomationProperties.Name="Interface Wi-Fi">
                                <ComboBox.ItemTemplate><DataTemplate><StackPanel Margin="1,2">
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="200" FontSize="12" />
                                    <TextBlock Style="{StaticResource InterfaceState}" FontSize="11" Margin="0,3,0,0" />
                                </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Atualizar interfaces" Command="{Binding RefreshCommand}" Style="{StaticResource QuietButton}" ToolTip="Atualizar interfaces Wi-Fi (F5)" Margin="0,8,0,14" />
                            <TextBlock Text="Destino IPv4" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanReplaceSession}"
                                     AutomationProperties.Name="Destino IPv4" ToolTip="IPv4 do gateway ou de outro destino autorizado" />
                            <TextBlock Text="{Binding TargetHint}" Style="{StaticResource Caption}" Margin="0,6,0,14" />
                            <TextBlock Text="Varredura Wi-Fi a cada 5 s, inclusive nos testes. Pode aumentar a latência medida." Style="{StaticResource Caption}" Foreground="#805A16" Margin="0,0,0,14" />
                            <TextBlock Text="Salvar resultados em" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditFolder}"
                                     AutomationProperties.Name="Pasta dos resultados" TextWrapping="Wrap" MinHeight="50" />
                            <Button Content="Escolher pasta…" Command="{Binding ChooseFolderCommand}" Style="{StaticResource QuietButton}" Margin="0,8,0,10" />
                            <Expander Header="Sobre os registros" Foreground="{StaticResource Muted}" FontSize="12">
                                <TextBlock Text="O JSON contém identificadores de rede. Revise antes de compartilhar. A coleta envia ICMP apenas para o destino informado." Style="{StaticResource Caption}" Margin="0,10,0,0" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16">
                <TabControl DataContext="{Binding Result}"
                            SelectedIndex="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
                    <TabItem Header="Sinal" DataContext="{Binding DataContext.Signal, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <Grid.Style><Style TargetType="Grid"><Setter Property="MinHeight" Value="460" /><Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded, ElementName=SignalDetails}" Value="True"><Setter Property="MinHeight" Value="560" /></DataTrigger>
                            </Style.Triggers></Style></Grid.Style>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" MinHeight="170" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Potência do sinal" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Border Background="{StaticResource AccentTint}" CornerRadius="4" Padding="7,4" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StateLabel}" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Heading}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="66">
                                        <TextBlock Text="{Binding Value}" FontSize="48" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                                   AutomationProperties.Name="{Binding Value, StringFormat=Sinal Wi-Fi: {0}}" />
                                    </Viewbox>
                                    <TextBlock Text="{Binding Position}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding ReadingStatus}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding RefreshNotice}" Style="{StaticResource Caption}" Foreground="#805A16" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,10,0,0">
                                    <Border Background="#F5F8FB" CornerRadius="7" Padding="13,9" Margin="0,0,0,7" MinWidth="118">
                                        <StackPanel><TextBlock Text="MÍNIMO REGISTRADO" FontSize="9" Foreground="{StaticResource Muted}" /><TextBlock Text="{Binding Minimum}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
                                    </Border>
                                    <Border Background="#F5F8FB" CornerRadius="7" Padding="13,9" MinWidth="118">
                                        <StackPanel><TextBlock Text="MÁXIMO REGISTRADO" FontSize="9" Foreground="{StaticResource Muted}" /><TextBlock Text="{Binding Maximum}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="Passe o mouse para inspecionar" DockPanel.Dock="Right" Style="{StaticResource Caption}" FontSize="11" />
                                    <StackPanel Orientation="Horizontal"><Ellipse Fill="#0F766E" Width="7" Height="7" Margin="0,0,7,0" /><TextBlock Text="RSSI registrado" FontSize="12" FontWeight="SemiBold" /></StackPanel>
                                </DockPanel>
                                <controls:SignalChart Grid.Row="1" Points="{Binding Points}" TimeAxisLabel="{Binding TimeAxisLabel}" ClipToBounds="True" AutomationProperties.Name="Histórico de RSSI em dBm" />
                            </Grid>
                            <StackPanel Grid.Row="2" Margin="0,13,0,0">
                                <TextBlock Text="{Binding ReadingsLabel}" FontSize="12" FontWeight="SemiBold" />
                                <Expander x:Name="SignalDetails" Header="Detalhes da medição" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0">
                                    <StackPanel Margin="0,9,0,0"><TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" /><TextBlock Text="{Binding LatestIssues}" TextWrapping="Wrap" Foreground="#B23C42" Margin="0,6,0,0" Visibility="{Binding HasIssues, Converter={StaticResource BoolVisibility}}" /><TextBlock Text="Lacunas e mudanças de contexto interrompem a linha. Atualização e precisão dependem do driver." Style="{StaticResource Caption}" Margin="0,5,0,0" /></StackPanel>
                                </Expander>
                            </StackPanel>
                        </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Resumo" Style="{StaticResource ResultTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource Card}" Margin="0,0,7,7"><StackPanel><TextBlock Text="POSIÇÕES DESPACHADAS" Style="{StaticResource Caption}" FontSize="10" /><TextBlock Text="{Binding Positions}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="7,0,0,7"><StackPanel><TextBlock Text="ICMP" Style="{StaticResource Caption}" FontSize="10" /><TextBlock Text="{Binding Icmp}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0,7,7,0"><StackPanel><TextBlock Text="RTT · SOMENTE SUCESSOS" Style="{StaticResource Caption}" FontSize="10" /><TextBlock Text="{Binding Rtt}" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="7,7,0,0"><StackPanel><TextBlock Text="RSSI REGISTRADO" Style="{StaticResource Caption}" FontSize="10" /><TextBlock Text="{Binding Rssi}" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></Border>
                            </UniformGrid>
                            <TextBlock Text="{Binding Availability}" TextWrapping="Wrap" Margin="0,20,0,10" />
                            <TextBlock Text="{Binding Schedule}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding Sources}" TextWrapping="Wrap" Margin="0,0,0,18" />
                            <TextBlock Text="{Binding ScanNotice}" TextWrapping="Wrap" Foreground="#805A16" Margin="0,0,0,18" />
                            <Border Background="#EDF6F4" CornerRadius="7" Padding="13"><TextBlock Text="{Binding ContextNotice}" TextWrapping="Wrap" FontSize="12" /></Border>
                            <TextBlock Text="Estatísticas descritivas, sem diagnóstico automático de cobertura ou saúde da rede. Frequência em cache não é uma nova recepção por consulta." Style="{StaticResource Caption}" Margin="0,14,0,0" />
                        </StackPanel></ScrollViewer>
                    </TabItem>
                    <TabItem Header="Amostras" Style="{StaticResource ResultTab}">
                        <DataGrid ItemsSource="{Binding Samples}" AutomationProperties.Name="Amostras da sessão">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Posição" Binding="{Binding Position}" Width="72" />
                                <DataGridTextColumn Header="RSSI" Binding="{Binding Rssi}" Width="100" />
                                <DataGridTextColumn Header="RTT" Binding="{Binding Rtt}" Width="100" />
                                <DataGridTextColumn Header="Wi-Fi" Binding="{Binding Wifi}" Width="120" />
                                <DataGridTextColumn Header="ICMP" Binding="{Binding Icmp}" Width="120" />
                                <DataGridTextColumn Header="Agenda" Binding="{Binding Disposition}" Width="180" />
                                <DataGridTextColumn Header="Canal" Binding="{Binding Channel}" Width="85" />
                                <DataGridTextColumn Header="Frequência / fonte" Binding="{Binding CachedFrequency}" Width="250" />
                                <DataGridTextColumn Header="Fonte RSSI" Binding="{Binding RssiSource}" Width="170" />
                                <DataGridTextColumn Header="Ocorrências (código)" Binding="{Binding Occurrences}" Width="350" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Contexto" Style="{StaticResource ResultTab}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="{Binding ContextNotice}" TextWrapping="Wrap" Margin="0,0,0,16" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Context}"><DataGrid.Columns>
                                <DataGridTextColumn Header="Campo" Binding="{Binding Field}" Width="200" />
                                <DataGridTextColumn Header="Contexto registrado" Binding="{Binding State}" Width="*" />
                            </DataGrid.Columns></DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Ocorrências" Style="{StaticResource ResultTab}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="{Binding OccurrenceNotice}" TextWrapping="Wrap" Margin="0,0,0,16" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Occurrences}"><DataGrid.Columns>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="*" />
                                <DataGridTextColumn Header="Código nativo" Binding="{Binding Code}" Width="135" />
                                <DataGridTextColumn Header="Posições" Binding="{Binding Positions}" Width="95" />
                            </DataGrid.Columns></DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,9,0,0">
            <TextBlock Text="Sessão de 60 segundos · sem telemetria" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding SavedPath, StringFormat=Arquivo salvo: {0}}" ToolTip="{Binding SavedPath}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,270,0"
                       Visibility="{Binding HasSavedPath, Converter={StaticResource BoolVisibility}}" />
        </Grid>
    </Grid>
</Window>
